{
  "name": "archipelago",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "db:up": "docker compose --env-file .env -f infra/docker/docker-compose.yml up -d --wait",
    "db:down": "docker compose --env-file .env -f infra/docker/docker-compose.yml down",
    "db:reset": "docker compose --env-file .env -f infra/docker/docker-compose.yml down -v && pnpm db:up",
    "db:logs": "docker compose --env-file .env -f infra/docker/docker-compose.yml logs -f",
    "db:psql": "docker compose --env-file .env -f infra/docker/docker-compose.yml exec postgres psql -U postgres -d archipelago"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  }
}
